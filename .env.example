# Copiar como .env y ajustar
DATABASE_URL=sqlite:///./financial.db
# PostgreSQL: postgresql+psycopg2://usuario:password@localhost:5432/financial
# Secreto para firmar los tokens (HS256). Genera uno propio, de 64 caracteres, con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# y ponlo en tu archivo .env. El .env no se sube a Git.
JWT_SECRET=pon-aqui-el-secreto-generado
ACCESS_TOKEN_EXPIRE_MINUTES=30
